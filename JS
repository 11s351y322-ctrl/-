    <!-- ナビゲーションバー (左サイドバー) -->
    <nav id="sidebar" class="bg-gray-900 text-white w-64 flex-shrink-0 flex flex-col shadow-xl z-30 fixed inset-y-0 left-0 transform -translate-x-full transition-transform duration-300 md:relative md:translate-x-0">
        <div class="p-4 bg-gray-950 flex items-center gap-2 border-b border-gray-800">
