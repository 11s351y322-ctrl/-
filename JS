            <button class="nav-btn w-full text-left px-4 py-2.5 rounded-lg text-sm font-bold transition-colors duration-150 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="section-availability-3">
                9. 空き状況一覧 (PDF 3)
            </button>
        </div>
    </nav>

    <!-- メインコンテンツ -->
    <main class="flex-1 overflow-y-auto p-4 md:p-8 bg-gray-100 relative">
        <div class="max-w-4xl mx-auto">

            <!-- 0. 元のメモ（編集用） -->
            <section id="section-memo" class="content-section hidden bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">📝</span>
                        <h2 class="text-lg font-bold text-gray-800">メモの追記と情報更新</h2>
                    </div>
                    <button id="update-ai-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg text-sm font-bold shadow-md transition flex items-center justify-center gap-2 shrink-0">
