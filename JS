                    </svg>
                    <h2 class="text-lg font-bold text-blue-800">1. 現状の厳しさと基本ルール</h2>
                </div>
                <div id="rules-content" class="p-6 space-y-4">
                    <!-- JSで描画 -->
                </div>
            </section>

            <!-- 2. 施設形態と特徴 (動的生成エリア) -->
            <section id="section-facilities" class="content-section hidden bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
