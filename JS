            </button>

            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mt-4 mb-1 pl-2">ワークスペース</div>
            <button class="nav-btn w-full text-left px-4 py-2.5 rounded-lg text-sm font-bold transition-colors duration-150 text-gray-400 hover:bg-gray-800 hover:text-white" data-target="section-tasks">
