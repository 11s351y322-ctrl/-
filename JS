                                    </label>
                                </div>
                                <div class="flex items-start gap-3">
                                    <input type="checkbox" id="task1-5" class="task-checkbox mt-1 h-5 w-5 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                                    <label for="task1-5" class="text-gray-800 cursor-pointer select-none">
                                        <span class="font-semibold block">空き状況の確認</span>
                                        <span class="text-sm text-gray-500">福岡市のHPや各園への電話で現在の空き状況を把握</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- フェーズ2 -->
                        <div>
                            <h3 class="font-bold text-gray-700 border-b pb-2 mb-3">フェーズ2：見学と選定</h3>
